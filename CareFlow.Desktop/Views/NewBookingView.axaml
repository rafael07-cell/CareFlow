<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CareFlow.Desktop.ViewModels"
             x:Class="CareFlow.Desktop.Views.NewBookingView"
             x:DataType="vm:NewBookingViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10" MaxWidth="560" HorizontalAlignment="Left">

      <TextBlock Classes="heading" Text="New Booking" />

      <TextBlock Text="Patient" FontWeight="SemiBold" />
      <ComboBox ItemsSource="{Binding Patients}"
                SelectedItem="{Binding SelectedPatient}"
                PlaceholderText="Select patient"
                HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding FullName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Text="Booking date" FontWeight="SemiBold" />
      <DatePicker SelectedDate="{Binding BookingDate}" />

      <TextBlock Text="Services (select 1 to 3)" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Services}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding ValidationMessage}" Foreground="DarkOrange" />

      <Button Classes="primary" Content="Confirm Booking"
              Command="{Binding SubmitCommand}" HorizontalAlignment="Left" />

      <TextBlock Classes="status" Text="{Binding StatusMessage}" IsVisible="{Binding !IsError}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding StatusMessage}" Foreground="IndianRed" IsVisible="{Binding IsError}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
